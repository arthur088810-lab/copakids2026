v>\r\n<\/div>\r\n\r\n<style>\r\n  #if-bird-float{\r\n    position:fixed;\r\n    top:10px;\r\n    left:16px; \/* topo esquerdo *\/\r\n    z-index:9998;\r\n    pointer-events:none;\r\n    width:130px; \/* maior *\/\r\n    max-width:30vw;\r\n    transition:opacity .3s ease, transform .3s ease;\r\n  }\r\n\r\n  #if-bird-float.hide{\r\n    opacity:0;\r\n    transform:translateY(-20px);\r\n  }\r\n\r\n  .if-bird-inner{\r\n    animation:ifBirdFloat 3.8s ease-in-out infinite;\r\n  }\r\n\r\n  \/* come\u00e7a invertido *\/\r\n  .if-bird-inner.if-flip{\r\n    transform:scaleX(-1);\r\n  }\r\n\r\n  #if-bird-float img{\r\n    width:100%;\r\n    height:auto;\r\n    display:block;\r\n    filter:drop-shadow(0 10px 18px rgba(0,0,0,.15));\r\n  }\r\n\r\n  @keyframes ifBirdFloat{\r\n    0%{ transform:translateY(0) rotate(-2deg); }\r\n    25%{ transform:translateY(-4px) translateX(6px) rotate(1deg); }\r\n    50%{ transform:translateY(-9px) rotate(2deg); }\r\n    75%{ transform:translateY(-3px) translateX(-5px) rotate(-1deg); }\r\n    100%{ transform:translateY(0) rotate(-2deg); }\r\n  }\r\n\r\n  @media (max-width: 767px){\r\n    #if-bird-float{\r\n      top:8px;\r\n      left:10px;\r\n      width:95px;\r\n      max-width:26vw;\r\n    }\r\n  }\r\n<\/style>\r\n\r\n<script>\r\n(function(){\r\n  var bird = document.querySelector('#if-bird-float');\r\n  var inner = document.querySelector('.if-bird-inner');\r\n\r\n  \/\/ esconder ao rolar\r\n  window.addEventListener('scroll', function(){\r\n    if(window.scrollY > 80){\r\n      bird.classList.add('hide');\r\n    } else {\r\n      bird.classList.remove('hide');\r\n    }\r\n  });\r\n\r\n  \/\/ flip cont\u00ednuo\r\n  function randomFlip(){\r\n    inner.classList.toggle('if-flip');\r\n    var next = Math.random() * 4000 + 4000;\r\n    setTimeout(randomFlip, next);\r\n  }\r\n\r\n  randomFlip();\r\n})();\r\n<\/script>","_margin_mobile":{"unit":"px","top":"-101","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[],"isInner":false,"wid